# Local -> Live database sync configuration
# Copy this file to .env.sync and fill in your live Supabase/Render DATABASE_URL.
# .env.sync is gitignored — never commit live credentials.

# Local Docker Postgres (default matches docker-compose.yml)
LOCAL_DATABASE_URL=postgresql://hms_user:hms_password@localhost:5432/hms_db

# Live production database (Supabase pooler URL from Render dashboard)
LIVE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Include invoices/payments/deposits in each sync (1=yes, 0=no)
SYNC_INCLUDE_FINANCIAL=1

# Default interval for watch mode / scheduled task (seconds). 900 = every 15 minutes.
SYNC_INTERVAL_SECONDS=900
